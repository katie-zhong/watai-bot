{
  "name": "watai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node src/index.ts",
    "register": "node --env-file=.env src/discord/register.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "luxon": "^3.7.2",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electric-sql/pglite": "^0.5.16",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
